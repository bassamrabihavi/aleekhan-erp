# Placeholders only - never commit real values. Copy to backend/.env (git-ignored) and load it into the
# shell environment (e.g. `set -a; . backend/.env; set +a`); settings read os.environ only.
ALEEKHAN_ENV=dev                      # dev | test | staging | prod
DJANGO_SECRET_KEY=CHANGE_ME # required for staging/prod; dev/test generate an ephemeral one
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: either DATABASE_URL ...
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<dbname>
# ... or libpq variables (used when DATABASE_URL is empty)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=CHANGE_ME
PGPASSWORD=CHANGE_ME
PGDATABASE=aleekhan_dev
# PGSSLMODE=require
# Optional: name of the throw-away test database created by pytest-django
# ALEEKHAN_TEST_DB_NAME=test_aleekhan
