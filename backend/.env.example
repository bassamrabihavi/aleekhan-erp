# Placeholders only - never commit real values. Copy to backend/.env (git-ignored) and load it into the
# shell environment (e.g. `set -a; . backend/.env; set +a`); settings read os.environ only.
ALEEKHAN_ENV=dev                      # dev | test | staging | prod
DJANGO_SECRET_KEY=CHANGE_ME # required for staging/prod; dev/test generate an ephemeral one
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: either DATABASE_URL ...
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<dbname>
# ... or libpq variables (used when DATABASE_URL is empty)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=CHANGE_ME
PGPASSWORD=CHANGE_ME
PGDATABASE=aleekhan_dev
# PGSSLMODE=require
# Optional: name of the throw-away test database created by pytest-django (empty = Django default)
ALEEKHAN_TEST_DB_NAME=

# Build identity shown by /api/v1/version (hex git sha, 7-40 chars). Required in staging/prod.
ALEEKHAN_BUILD_COMMIT=
DJANGO_LOG_LEVEL=INFO

# API runtime (docs/api/API_RUNTIME.md section 4). Empty = built-in default.
ALEEKHAN_RATE_ANON=60/min
ALEEKHAN_RATE_PRINCIPAL=600/min
ALEEKHAN_RATE_HEALTH=120/min
ALEEKHAN_MAX_BODY_BYTES=1048576
# Shared rate-limit counters; recommended in staging/prod. Empty = per-process local memory.
# Example shape only: redis://<host>:6379/0
ALEEKHAN_REDIS_URL=

# Reverse proxy and TLS (staging/prod behind the proxy: NUM_PROXIES=1, TRUST_PROXY_TLS_HEADER=1)
ALEEKHAN_NUM_PROXIES=0
ALEEKHAN_TRUST_PROXY_TLS_HEADER=0
# Empty = environment default (1 in staging/prod, off in dev/test)
ALEEKHAN_SSL_REDIRECT=
# Empty = environment default (31536000 in prod, 0 otherwise); prod refuses < 86400
ALEEKHAN_HSTS_SECONDS=
ALEEKHAN_HSTS_INCLUDE_SUBDOMAINS=0
